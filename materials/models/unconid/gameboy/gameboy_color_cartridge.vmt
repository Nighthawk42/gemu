"vertexlitgeneric"
{
	"$basetexture"	 "models\unconid\gameboy\gameboy_color_cartridge"
	"$bumpmap"	 "models\unconid\gameboy\gameboy_cartridge_normal"


	$translucent 1
	"$phong" "1"
	"$phongexponent" "20"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[.2 4 1]"

	"$rimlight" "1"												
	"$rimlightexponent" "1"				
	"$rimlightboost" ".3"



	
}
